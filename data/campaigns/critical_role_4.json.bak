  "universal_pcs": [
    {
      "personaje": "Halandil \"Hal\" Fang",
      "jugador": "Liam O'Brien",
      "especie": "Orc",
      "clase": "Bardo (Bard)",
      "subclase": "College of Eloquence",
      "debut_sesion": 1,
      "hitos_acumulados": [
        "Sesión #1: Mourned his brother Thiazi, connected with him telepathically in his final moments, and hosted a tense wake at his home.",
        "Sesión #2: Revived Tysha Loy after the cursed coffin incapacitated her, performed a tribute song for Thiazi, and committed to unraveling his brother's final conspiracies.",
        "Sesión #3: Hal inspected Thiazi's lead paint crates with Bolaire at the Rondo of the Alhambra and bestowed his fallen brother's scimitar upon the departing party.",
        "Sesión #4: Confrontó a Bolaire en la Bóveda del Arcanum tras descubrir su verdadera identidad como artefacto viviente de la Guerra de los Moldeadores.",
        "Sesión #5: He read Thiazi's letter with Murray and confronted Bolaire, learning that his long-time friend is actually a sentient god-killing mask."
      ],
      "aliases": [
        "Halendiel 'Hal' Fang",
        "Hal Fang",
        "Hal"
      ]
    },
    {
      "personaje": "Azune Nayar",
      "jugador": "Luis Carazo",
      "especie": "Human",
      "clase": "Paladin/Sorcerer",
      "subclase": "Draconic (presunta)",
      "debut_sesion": 1,
      "hitos_acumulados": [
        "Sesión #1: Used magic to scan Thiazi before the execution, delivered his body to Hal, and led the investigation into the flophouse.",
        "Sesión #2: Analyzed political corruption within the Revolutionary Guard, saw through Lord Einfasen's scheme, and reassigned his patrol to cover the party in Caravan Hill.",
        "Sesión #3: Azune patrolled Caravan Hill amidst shifting anti-magic laws and assisted the party in slipping past city guards.",
        "Sesión #4: Ejecutó Mending sobre la campana negra reconstruyendo la memoria del artefacto para guiar al grupo hasta el cuerpo de Octus.",
        "Sesión #5: He spent the night mourning at Falcon's Rest, resolved never to forget his fallen allies, and joined Murray to find the survivors."
      ],
      "aliases": [
        "Azune"
      ]
    },
    {
      "personaje": "Thaisha Lloy",
      "jugador": "Aabria Iyengar",
      "especie": "Orc",
      "clase": "Druida (Druid)",
      "subclase": "Circle of the Land",
      "debut_sesion": 1,
      "hitos_acumulados": [
        "Sesión #1: Used druidcraft to enrich the garden, comforted Hal's family, and had a tense confrontation with Sir Julian DeVino.",
        "Sesión #2: Survived touching the cursed celestial coffin, deduced with an Arcana check that Thiazi was sabotaged with a decoy glyph, and communed with Wulfric.",
        "Sesión #3: Tysha shared a poignant moment with Shadia at the Rondo of the Alhambra and warned Vaelas of the dark magic surrounding Palazzo DeVino.",
        "Sesión #4: Sostuvo el alma de Octus desde el plano astral impidiendo que fuera arrastrado al abismo por la magia de Primus Taconis.",
        "Sesión #5: She fought bravely at Palazzo DeVino, survived a Circle of Death, and used her spiritual connection to call Octus back from the brink of death."
      ],
      "aliases": [
        "Tysha Loy",
        "Thaisha",
        "Tysha"
      ]
    },
    {
