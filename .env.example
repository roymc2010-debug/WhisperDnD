# ==============================================================================
# WhisperDnD & Study - Environment Configuration Template
# ==============================================================================

# API Keys (Optional if provided by user via Web UI headers / BYOK)
GEMINI_API_KEY=
GROQ_API_KEY=

# Local faster-whisper Model Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=models

# Gemini LLM Model Selection (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Storage & Directory Overrides (Optional - defaults to data/ or outputs/)
# WHISPER_INPUT_DIR=data/input
# WHISPER_OUTPUT_DIR=outputs
# WHISPER_CAMPAIGNS_DIR=data/campaigns

# Server Network & Host Settings
PORT=8080
# WHISPERDND_SERVER_URL=https://whisperdnd.onrender.com
# RENDER_EXTERNAL_URL=https://whisperdnd.onrender.com

# Google Drive Integration via Raw JSON Environment Variables (Cloud Run / Render)
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_TOKEN_JSON=
# GOOGLE_DRIVE_FOLDER_NAME=WhisperDnD
